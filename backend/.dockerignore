# Evidentia Backend — Docker Build Context Exclusions
#
# Keeps secrets, credentials, test fixtures, development tools, and unnecessary files
# out of the Docker build context.

# Version control
.git
.gitignore
.github

# Environment & Secrets — NEVER baked into an image layer
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
certs/
secrets/

# Local database files & storage
*.db
*.sqlite
*.sqlite3
data/
minio_data/
postgres_data/
redis_data/

# Logs & Temporary evidence
logs/
*.log
tmp/
temp/
evidence/
temporary_evidence/

# Build artifacts & Dependencies
bin/
node_modules/

# Test fixtures and test infrastructure
testdata/
tests/
coverage.out
coverage.html
*_test.go

# Documentation (not needed at runtime)
docs/
*.md
!README.md

# IDE & Editor artifacts
.idea/
.vscode/
*.sublime-workspace
*.swp

# OS artifacts
.DS_Store
Thumbs.db

# Backups
backups/
*.bak
