# Evidentia Backend — Environment Example
#
# Copy to .env for local development when running the Go binary directly
# (go run ./cmd/server), outside Docker. When running via docker-compose,
# these values are instead supplied as container environment variables —
# see ../docker-compose.yml and ../.env.example.
#
# NEVER commit a real .env file. Only fake/example values belong here.
# Credentials below have no default in code (internal/config) — they must
# be set explicitly or the application refuses to start.

# ---- App ----
APP_ENV=development
APP_NAME=evidentia-backend
APP_VERSION=dev

# ---- HTTP server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_BODY_BYTES=1048576

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID
CORS_ALLOW_CREDENTIALS=false

# ---- Database ----
# DATABASE_USER/PASSWORD are the least-privilege evidentia_app runtime
# role cmd/server connects as — never a Postgres superuser (see
# docs/DATABASE_SCHEMA.md). DATABASE_MIGRATOR_USER/PASSWORD are a
# separate, privileged, schema-owning role used only by cmd/migrate and
# scripts/seed_db.sh — never by the running server.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=evidentia_app
DATABASE_PASSWORD=change-me
DATABASE_NAME=evidentia
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_MIGRATOR_USER=change-me
DATABASE_MIGRATOR_PASSWORD=change-me

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false
MINIO_BUCKET=evidentia-documents

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Authentication (System 3) ----
JWT_ISSUER=evidentia-api
JWT_AUDIENCE=evidentia-client
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# HMAC secret (HS256) — required, no default, minimum 32 characters (see
# internal/config/validate.go and docs/SECURITY.md for why HS256 over
# RS256). Never a real secret in this file.
JWT_SIGNING_KEY=change-me-to-a-random-string-at-least-32-characters-long
BCRYPT_COST=12

# ---- Reserved for later systems (not read by System 1-3 / internal/config) ----
AES_KEY=change-me-32-byte-key
TLS_CERT_FILE=
TLS_KEY_FILE=
