# Evidentia Backend — Environment Example
#
# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file. Only fake/example values belong here.

# ---- App ----
APP_ENV=development
APP_PORT=8080
APP_NAME=evidentia-backend

# ---- Database ----
DATABASE_URL=postgres://evidentia:changeme_example@localhost:5432/evidentia?sslmode=disable

# ---- JWT ----
JWT_SECRET=changeme_example_jwt_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme_example_access_key
MINIO_SECRET_KEY=changeme_example_secret_key
MINIO_BUCKET=evidentia-documents
MINIO_USE_SSL=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Crypto ----
AES_KEY=changeme_example_32_byte_aes_key

# ---- TLS ----
TLS_CERT_FILE=./certs/example.crt
TLS_KEY_FILE=./certs/example.key
