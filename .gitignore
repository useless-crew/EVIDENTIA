# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ---- Backend (Go) ----

# Environment files
.env
.env.*
!.env.example

# Build artifacts
bin/
tmp/
backend/bin/
backend/tmp/

# Test coverage
coverage.out
coverage.html

# sqlc generated code IS committed (backend/db/generated/*.go) — go build
# and go test must work right after a fresh clone without requiring the
# sqlc CLI to be installed. Regenerate with `make sqlc` after changing
# backend/db/queries/*.sql or backend/db/migrations/*.sql; never hand-edit.

# swag-generated Swagger/OpenAPI output — unlike db/generated, nothing
# imports this, so an empty directory is harmless to `go build ./...` on a
# fresh clone. Regenerate with `make swagger`; never hand-edit.
backend/docs/swagger/docs.go
backend/docs/swagger/swagger.json
backend/docs/swagger/swagger.yaml

# Secrets (never commit)
*.pem
*.key
*.crt
!backend/certs/README.md
secrets/

# ---- Frontend (Angular, rooted at frontend/) ----

# Compiled output
/frontend/dist
/frontend/out-tsc
/frontend/bazel-out

# Node
/frontend/node_modules
npm-debug.log
yarn-error.log

# Miscellaneous
/frontend/.angular/cache
.sass-cache/
/connect.lock
/frontend/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# ---- Shared ----

# Logs
*.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
/frontend/.vscode/*
!/frontend/.vscode/settings.json
!/frontend/.vscode/tasks.json
!/frontend/.vscode/launch.json
!/frontend/.vscode/extensions.json
!/frontend/.vscode/mcp.json
.history/*

# System files
.DS_Store
Thumbs.db
