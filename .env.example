# Evidentia — Root Environment Example
#
# Consumed by docker-compose.yml when running the full local stack
# (postgres, redis, minio, backend). Backend-specific variables used when
# running the Go binary directly (outside Docker) live in
# backend/.env.example.
#
# docker-compose.yml already falls back to these exact placeholder values
# on its own, so copying this file to .env is optional for local dev —
# only needed to override a value (e.g. use a real MINIO_ROOT_PASSWORD).
#
# NEVER put real secrets in this file or in any committed file.

# ---- General ----
APP_ENV=development
APP_VERSION=dev

# ---- Postgres ----
POSTGRES_USER=evidentia
POSTGRES_PASSWORD=changeme_example
POSTGRES_DB=evidentia
POSTGRES_PORT=5432

# ---- MinIO ----
MINIO_ROOT_USER=evidentia_minio
MINIO_ROOT_PASSWORD=changeme_example
MINIO_BUCKET=evidentia-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Documents (System 6) ----
# Max size, in bytes, of a single uploaded evidence file. 50 MiB default.
MAX_UPLOAD_SIZE=52428800

# ---- Redis ----
REDIS_PORT=6379

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Authentication (System 3) ----
JWT_ISSUER=evidentia-api
JWT_AUDIENCE=evidentia-client
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Placeholder — internal/config requires at least 32 characters. Override
# for anything beyond throwaway local dev; never commit a real value.
JWT_SIGNING_KEY=changeme_example_jwt_signing_key_pad_to_32
BCRYPT_COST=12

# ---- Compliance certificates (System 7) ----
# PEM-encoded PKCS#8 ECDSA private key used to sign compliance
# certificates. Left EMPTY here on purpose (no placeholder value, unlike
# JWT_SIGNING_KEY above) — unset is a supported configuration; the
# backend falls back to a fresh, process-lifetime-only key instead of
# refusing to start. Set this for certificates that must stay verifiable
# across a restart. NEVER commit a real key.
# CERTIFICATE_SIGNING_KEY=

# ---- Initial admin bootstrap (System 8) ----
# Provisions the ONE account created outside normal admin-driven user
# management (see internal/bootstrap). All three must be either set
# together or all left unset — internal/config rejects a partial group at
# startup. Leave unset after the first successful deploy (or for local dev
# using backend/cmd/devuser instead): the bootstrap is a no-op once any
# ADMIN account exists, and never overwrites an existing one.
# NEVER commit real values — supply them securely at deploy time only.
EVIDENTIA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EVIDENTIA_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_IN_DEPLOYMENT
EVIDENTIA_BOOTSTRAP_ADMIN_NAME=System Administrator

# ---- Backend service ----
BACKEND_PORT=8080

# ---- Frontend service (placeholder; not built in this system) ----
FRONTEND_PORT=4200
