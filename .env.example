# Evidentia — Root Environment Example
#
# Consumed by docker-compose.yml when running the full local stack
# (postgres, redis, minio, backend). Backend-specific variables used when
# running the Go binary directly (outside Docker) live in
# backend/.env.example.
#
# docker-compose.yml already falls back to these exact placeholder values
# on its own, so copying this file to .env is optional for local dev —
# only needed to override a value (e.g. use a real MINIO_ROOT_PASSWORD).
#
# NEVER put real secrets in this file or in any committed file.

# ---- General ----
APP_ENV=development
APP_VERSION=dev

# ---- Postgres ----
POSTGRES_USER=evidentia
POSTGRES_PASSWORD=changeme_example
POSTGRES_DB=evidentia
POSTGRES_PORT=5432

# ---- MinIO ----
MINIO_ROOT_USER=evidentia_minio
MINIO_ROOT_PASSWORD=changeme_example
MINIO_BUCKET=evidentia-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Redis ----
REDIS_PORT=6379

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Backend service ----
BACKEND_PORT=8080

# ---- Frontend service (placeholder; not built in this system) ----
FRONTEND_PORT=4200
