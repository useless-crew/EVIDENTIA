# Evidentia — Root Environment Example
#
# This file documents environment variables used by docker-compose at the
# repository root. Backend-specific variables live in backend/.env.example.
#
# NEVER put real secrets in this file or in any committed file.

# ---- General ----
APP_ENV=development

# ---- Postgres (docker-compose) ----
POSTGRES_USER=evidentia
POSTGRES_PASSWORD=changeme_example
POSTGRES_DB=evidentia
POSTGRES_PORT=5432

# ---- MinIO (docker-compose) ----
MINIO_ROOT_USER=evidentia_minio
MINIO_ROOT_PASSWORD=changeme_example
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Redis (docker-compose) ----
REDIS_PORT=6379

# ---- Backend service ----
BACKEND_PORT=8080

# ---- Frontend service (future) ----
FRONTEND_PORT=3000
