# Evidentia — Production Environment Configuration Template
#
# IMPORTANT:
# 1. Never commit real credentials, private keys, or tokens to version control.
# 2. In AWS ECS Fargate, inject secrets directly from AWS Secrets Manager
#    into container environment variables via task definitions (IAM-authenticated).
# 3. All localhost defaults have been replaced with production infrastructure variables.
# 4. In production (APP_ENV=production), CORS_ALLOWED_ORIGINS must NOT include "*".

# ---- Application Identity ----
APP_ENV=production
APP_NAME=evidentia-backend
APP_VERSION=1.0.0

# ---- HTTP Server Configuration ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_BODY_BYTES=1048576

# ---- Reverse Proxy / Load Balancer Integration ----
# Set to VPC CIDR or specific private subnet CIDRs of the ALB
TRUSTED_PROXIES=10.0.0.0/16

# ---- Cross-Origin Resource Sharing (CORS) ----
# Explicitly restricted to production frontend domain — wildcard "*" is strictly prohibited in production
CORS_ALLOWED_ORIGINS=https://app.evidentia.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID
CORS_ALLOW_CREDENTIALS=false

# ---- PostgreSQL Database (Amazon RDS PostgreSQL 15) ----
# Connection pooling and TLS enforcement
DATABASE_HOST=evidentia-prod-db.cxxxxxx.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=evidentia_app
DATABASE_PASSWORD=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>
DATABASE_NAME=evidentia
DATABASE_SSLMODE=require
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# ---- Redis Cache & Task Queue (AWS ElastiCache Redis 7) ----
# In-transit TLS encryption and authentication token required
REDIS_ADDR=evidentia-prod-redis.xxxxxx.0001.aps1.cache.amazonaws.com:6379
REDIS_PASSWORD=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>
REDIS_DB=0
REDIS_TLS=true
REDIS_TLS_INSECURE=false

# ---- MinIO Object Storage (Private EC2 with Encrypted gp3 EBS) ----
# Internal private IP or Route 53 private DNS; never exposed to public Internet
MINIO_ENDPOINT=minio.internal.evidentia.local:9000
MINIO_ACCESS_KEY=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>
MINIO_SECRET_KEY=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>
MINIO_USE_SSL=true
MINIO_BUCKET=evidentia-documents
MAX_UPLOAD_SIZE=52428800

# ---- Structured Operational Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Authentication & Tokens (JWT) ----
JWT_ISSUER=evidentia-api
JWT_AUDIENCE=evidentia-client
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_SIGNING_KEY=<SECRET_32_CHAR_MIN_MANAGED_IN_AWS_SECRETS_MANAGER>
BCRYPT_COST=12

# ---- Compliance Certificate Signing (ECDSA P-256) ----
# Optional: supply PEM-encoded PKCS#8 ECDSA private key from Secrets Manager
# CERTIFICATE_SIGNING_KEY=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>

# ---- Login Brute-Force Rate Limiting (Redis-backed) ----
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IP_WINDOW=15m
LOGIN_RATE_LIMIT_ACCOUNT_MAX=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW=15m

# ---- Initial Administrator Bootstrap (One-Time Startup) ----
# Provide only for initial bootstrap; leave unset on subsequent deployments
# EVIDENTIA_BOOTSTRAP_ADMIN_EMAIL=admin@evidentia.example.com
# EVIDENTIA_BOOTSTRAP_ADMIN_PASSWORD=<SECRET_MANAGED_IN_AWS_SECRETS_MANAGER>
# EVIDENTIA_BOOTSTRAP_ADMIN_NAME=System Administrator

# ---- Hyperledger Fabric Blockchain Provenance (System 20) ----
# Permissioned private ledger on internal network
FABRIC_ENABLED=true
FABRIC_PEER_ENDPOINT=peer0.police.internal.evidentia.local:7051
FABRIC_GATEWAY_SSL_HOST_OVERRIDE=peer0.police.evidentia.local
FABRIC_CHANNEL=evidentia-channel
FABRIC_CHAINCODE=evidentia
FABRIC_MSP_ID=PoliceMSP
FABRIC_CERT_PATH=/etc/evidentia/fabric/client.crt
FABRIC_KEY_PATH=/etc/evidentia/fabric/client.key
FABRIC_TLS_CERT_PATH=/etc/evidentia/fabric/peer-ca.crt
