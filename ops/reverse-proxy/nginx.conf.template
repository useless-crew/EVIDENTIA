# Evidentia reverse proxy — TLS termination, HTTP->HTTPS redirect, and
# routing to the frontend/backend containers (System 17).
#
# This is the ONLY service in the production compose that publishes a
# host port (docker-compose.prod.yml) — frontend/backend/postgres/redis/
# minio all stay on the internal network. See docs/DEPLOYMENT.md's
# "Production-like deployment" section for the full architecture.
#
# Templated via the official nginx image's envsubst-on-startup mechanism
# (docker-entrypoint.d/20-envsubst-on-templates.sh, present in
# nginxinc/nginx-unprivileged too) — every ${VAR} below is substituted
# from the container's environment at startup, NOT at build time, so one
# image works for both the self-signed demo cert path and a real
# mounted-certificate deployment without a rebuild. Only the variables
# referenced below are substituted (NGINX_ENVSUBST_FILTER is set in
# docker-compose.prod.yml) so nginx's own "$host"/"$remote_addr"-style
# runtime variables are left untouched.

# Upstream names match docker-compose.prod.yml's service names exactly —
# Docker's embedded DNS resolves them within the internal network.
upstream evidentia_frontend {
    server frontend:8080;
}

upstream evidentia_backend {
    server backend:8080;
}

# ---- HTTP: redirect to HTTPS, except the ACME/health-check path ----
server {
    listen 8080;
    server_name _;

    # Lets an operator curl the plain-HTTP port for a quick liveness check
    # without a certificate — never proxies to the backend, so it leaks no
    # dependency/application state (see internal/handlers/health.Liveness
    # for the equivalent authoritative check, reached over HTTPS below).
    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

# ---- HTTPS: TLS termination, security headers, routing ----
server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Matches internal/config.DocumentsConfig.MaxUploadSize's default (50
    # MiB) plus headroom for multipart overhead — see MAX_UPLOAD_SIZE in
    # .env.example. If you change MAX_UPLOAD_SIZE, update this too: the
    # smaller of the two limits wins, exactly like
    # body_limit_middleware.go's own doc comment describes for the
    # backend's two independent limits.
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # HSTS applies at the server level (transport-level, correct for
    # every response this proxy serves, API included — the backend has
    # no TLS knowledge of its own to set this itself). The REST of the
    # security headers are set per-location instead, deliberately NOT
    # here: an nginx add_header at server scope is inherited by every
    # location that has no add_header of its own, which would apply a
    # generic, HTML-oriented header set to every API response too,
    # DUPLICATING (or worse, silently overriding with a weaker value —
    # confirmed while validating this file) the backend's own, more
    # precisely-tuned headers (middleware.SecurityHeaders — System 15
    # sets Referrer-Policy: no-referrer and Cache-Control: no-store for
    # the API specifically, stricter than what's appropriate for the
    # frontend's cacheable HTML shell). See `location /` below for the
    # frontend's own header set.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ---- SSE endpoints: buffering OFF, long read timeout, no chunked
    # re-encoding — see docs/REALTIME_EVENTS.md and internal/sse's own
    # doc comments for why a dropped/buffered proxy connection would
    # silently break audit-chain-verification progress and case/admin
    # notification streams. ----
    location ~ ^/api/v1/(cases/[^/]+/events|admin/users/events|audit/verify-chain/[^/]+/events)$ {
        proxy_pass http://evidentia_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        # SSE connections are intentionally long-lived (System 13's
        # Stream has its own ~1h forced-reconnect ceiling) — this must
        # exceed that so the PROXY is never what ends the connection.
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
    }

    # ---- Everything else under /api/, /health, /ready: normal
    # request/response proxying, the backend's own timeouts apply. Each
    # passes the backend's own security headers straight through
    # untouched (see the doc comment above HSTS's add_header). ----
    location /api/ {
        proxy_pass http://evidentia_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://evidentia_backend;
        proxy_set_header Host $host;
    }

    location = /ready {
        proxy_pass http://evidentia_backend;
        proxy_set_header Host $host;
    }

    # ---- Everything else: the Angular SPA. This is the one location
    # that needs its OWN full header set (nginx's add_header does not
    # inherit additively — a location with any add_header of its own
    # must repeat HSTS too, or it would silently lose it). ----
    location / {
        proxy_pass http://evidentia_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }
}
